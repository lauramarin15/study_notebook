# StudyNotebook - variables de entorno
# Copia este archivo a ".env" y ajusta los valores:
#   cp .env.example .env

# --- Embeddings (se ejecutan dentro del contenedor del backend) ---
# Modelo multilingüe de 384 dimensiones. Si lo cambias, debes ajustar
# vector(384) en db/init.sql y regenerar la base de datos (docker compose down -v).
EMBEDDING_MODEL=intfloat/multilingual-e5-small

#Ollama (local, gratis). Ollama debe estar instalado y abierto
# en tu máquina, y el modelo descargado: ollama pull qwen2.5:7b
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_URL=http://host.docker.internal:11434
